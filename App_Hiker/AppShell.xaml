<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="App_Hiker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:App_Hiker"
    xmlns:view_auth="clr-namespace:App_Hiker.View.Auth"
    Title="App_Hiker">

    <Shell.Style>
        <Style TargetType="Shell">
            <Setter Property="Shell.NavBarIsVisible" Value="False"/>
        </Style>
    </Shell.Style>

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate view_auth:Login}"
        Route="Auth" />

</Shell>
