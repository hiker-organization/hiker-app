<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_Hiker.View.User.Profile">
    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,*">
        <HorizontalStackLayout BackgroundColor="Aqua" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3">
            <Image/>

            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Border>
                    <HorizontalStackLayout VerticalOptions="Center">
                        <Label Text="&#xf249;" FontFamily="FontAwesomeFreeSolid900" TextColor="{ DynamicResource Primary }"/>
                        <Label Text="Posts: 10" />
                    </HorizontalStackLayout>
                </Border>

                <Border>
                    <HorizontalStackLayout VerticalOptions="Center">
                        <Label Text="&#xf005;" FontFamily="FontAwesomeFreeSolid900" TextColor="{ DynamicResource Primary }"/>
                        <Label Text="Pontuação: 80%" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </HorizontalStackLayout>
    </Grid>
</ContentView>