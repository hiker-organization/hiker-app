<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:parent="clr-namespace:App_Hiker.View.User"
             x:Class="App_Hiker.View.User.UserReviewsListing"
             x:Name="ReviewsListingRoot">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="lbl_alignment_left">
                <Setter Property="HorizontalTextAlignment" Value="Start"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Label" x:Key="lbl_alignment_right">
                <Setter Property="HorizontalTextAlignment" Value="End"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <ContentView.Content>
        <ScrollView Padding="15">
            <CollectionView ItemsSource="{ Binding reviews }" Grid.Column="0" Grid.Row="0" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                <CollectionView.EmptyView>
                    <Label Text="Nenhum post para ser exibido." Padding="5"/>
                </CollectionView.EmptyView>

                <CollectionView.Header>
                    <Label Text="Meus Posts" FontSize="Small" Padding="5"/>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="Transparent" StrokeShape="{ RoundRectangle CornerRadius=15 }" StrokeThickness="0">
                            <Border.Content>
                                <VerticalStackLayout Padding="15">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0" Grid.Row="0" Stroke="{ DynamicResource BaseContent }" StrokeShape="Ellipse">
                                            <Border.Content>
                                                <Image Source="{ Binding Source={ RelativeSource AncestorType={ x:Type parent:UserReviewsListing } },Path=BindingContext.foto_url}" Aspect="AspectFill" HeightRequest="50" WidthRequest="50"/>
                                            </Border.Content>
                                        </Border>

                                        <Label Grid.Column="1" Grid.Row="0" Text="{ Binding local }" FontSize="Small" Style="{ StaticResource lbl_alignment_left }"/>

                                        <Button Grid.Column="2"
                                                Grid.Row="0"
                                                Text="&#xf1f8;"
                                                FontFamily="FontAwesomeFreeSolid900"
                                                BackgroundColor="Transparent"
                                                BorderColor="Transparent"
                                                BorderWidth="0"
                                                TextColor="{ DynamicResource Error }"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                Padding="0"
                                                VerticalOptions="Start"
                                                Command="{ Binding DeleteCommand, Source={x:Reference ReviewsListingRoot} }"
                                                CommandParameter="{ Binding . }"/>
                                    </Grid>

                                    <Label Text="{ Binding descricao }" HorizontalTextAlignment="Justify"/>

                                    <CollectionView ItemsSource="{ Binding tags }"
                                                    SelectionMode="None"
                                                    HorizontalScrollBarVisibility="Never"
                                                    Margin="0,6,0,0">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border BackgroundColor="{ DynamicResource Base200 }"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 999"
                                                        Padding="10,4">
                                                       <Label Text="{ Binding descritivo }"
                                                           FontSize="12"
                                                           TextColor="{ DynamicResource BaseContent }"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <ScrollView Orientation="Horizontal"
                                                HorizontalScrollBarVisibility="Never">
                                        <HorizontalStackLayout BindableLayout.ItemsSource="{ Binding fotos }"
                                                               Spacing="6">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{ Binding url }"
                                                           HeightRequest="180"
                                                           WidthRequest="280"
                                                           Aspect="AspectFill"/>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </ScrollView>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                                        <Label Grid.Column="0" Grid.Row="0" Text="{ Binding nota, StringFormat='{}{0} &#xf005;' }" FontFamily="FontAwesomeFreeSolid900" TextColor="{ DynamicResource Primary }" Style="{ StaticResource lbl_alignment_left }"/>

                                        <Label Grid.Column="1" Grid.Row="0" Text="{ Binding createdAt, StringFormat='{}{0:dd/MM/yyyy}' }" Style="{ StaticResource lbl_alignment_right }"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border.Content>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
    </ContentView.Content>
</ContentView>
