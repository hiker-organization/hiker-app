<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:review="clr-namespace:App_Hiker.Model.Review.Response"
             x:Class="App_Hiker.View.User.Feed">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="lbl_feed_meta_left">
                <Setter Property="HorizontalTextAlignment" Value="Start"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Label" x:Key="lbl_feed_meta_right">
                <Setter Property="HorizontalTextAlignment" Value="End"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Button" x:Key="btn_feed_reaction">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="BorderColor" Value="Transparent"/>
                <Setter Property="BorderWidth" Value="0"/>
                <Setter Property="FontFamily" Value="FontAwesomeFreeSolid900"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="WidthRequest" Value="34"/>
                <Setter Property="HeightRequest" Value="34"/>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BackgroundColor="{ DynamicResource Neutral }"
                StrokeThickness="0"
                Padding="15,18,15,14">
            <VerticalStackLayout Spacing="12">
                <Image Source="logo.png"
                       HeightRequest="48"
                       HorizontalOptions="Center"
                       Aspect="AspectFit"/>

                <Border BackgroundColor="{ DynamicResource Base100 }"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        Padding="10,0">
                    <SearchBar Placeholder="Buscar lugares..."
                               BackgroundColor="Transparent"
                               TextColor="{ DynamicResource BaseContent }"
                               PlaceholderColor="{ DynamicResource NeutralContent }"/>
                </Border>
            </VerticalStackLayout>
        </Border>

        <CollectionView x:Name="clview_feed"
                        Grid.Row="1"
                        Margin="15,12,15,20"
                        SelectionMode="None"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="16"/>
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="Nenhum post para ser exibido."
                       Padding="5"
                       HorizontalTextAlignment="Center"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 15">
                        <VerticalStackLayout Padding="15" Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        Grid.Row="0"
                                        Stroke="{ DynamicResource BaseContent }"
                                        StrokeShape="Ellipse">
                                    <Image Source="{ Binding autor.foto_url, TargetNullValue=profile.png }"
                                           Aspect="AspectFill"
                                           HeightRequest="50"
                                           WidthRequest="50"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                            Grid.Row="0"
                                            Spacing="2"
                                            VerticalOptions="Center">
                                 <Label Text="{ Binding autor.nome_exibicao }"
                                     FontAttributes="Bold"
                                     FontSize="14"
                                     HorizontalTextAlignment="Start"/>

                                 <Label Text="{ Binding autor.nome_usuario }"
                                     FontSize="12"
                                     Opacity="0.7"
                                     HorizontalTextAlignment="Start"/>

                                 <Label Text="{ Binding local }"
                                     FontSize="12"
                                     HorizontalTextAlignment="Start"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="{ Binding descricao }"
                                   HorizontalTextAlignment="Justify"/>

                            <CollectionView ItemsSource="{ Binding tags }"
                                            SelectionMode="None"
                                            HorizontalScrollBarVisibility="Never"
                                            Margin="0,2,0,0">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{ DynamicResource Base200 }"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 999"
                                                Padding="10,4">
                                              <Label Text="{ Binding descritivo }"
                                                  FontSize="12"
                                                  TextColor="{ DynamicResource BaseContent }"
                                                  HorizontalTextAlignment="Center"
                                                  VerticalTextAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <ScrollView Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout BindableLayout.ItemsSource="{ Binding fotos }"
                                                       Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{ Binding url }"
                                                   HeightRequest="180"
                                                   WidthRequest="280"
                                                   Aspect="AspectFill"/>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Grid.Row="0"
                                           Text="{ Binding nota, StringFormat='Nota {0}' }"
                                           FontAttributes="Bold"
                                           Style="{ StaticResource lbl_feed_meta_left }"/>

                                    <Label Grid.Column="1"
                                           Grid.Row="0"
                                           Text="{ Binding createdAt, StringFormat='{}{0:dd/MM/yyyy}' }"
                                           Style="{ StaticResource lbl_feed_meta_right }"/>

                                    <Label Grid.Column="0"
                                           Grid.Row="1"
                                           Text="{ Binding qnt_likes, StringFormat='{}{0} likes' }"
                                           FontSize="12"
                                           Opacity="0.7"
                                           Style="{ StaticResource lbl_feed_meta_left }"/>

                                    <Label Grid.Column="1"
                                           Grid.Row="1"
                                           Text="{ Binding qnt_dislikes, StringFormat='{}{0} dislikes' }"
                                           FontSize="12"
                                           Opacity="0.7"
                                           Style="{ StaticResource lbl_feed_meta_right }"/>
                                </Grid>

                                <HorizontalStackLayout Grid.Column="1"
                                                       Spacing="4"
                                                       HorizontalOptions="End"
                                                       VerticalOptions="End">
                                    <Button Text="&#xf004;"
                                            ClassId="like"
                                            Style="{ StaticResource btn_feed_reaction }"
                                            TextColor="{ DynamicResource BaseContent }"
                                            Clicked="Reaction_Clicked">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{ Binding liked }" Value="True">
                                                <Setter Property="TextColor" Value="{ DynamicResource Primary }"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button" Binding="{ Binding disliked }" Value="True">
                                                <Setter Property="TextColor" Value="{ DynamicResource BaseContent }"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <Button Text="&#xf00d;"
                                            ClassId="dislike"
                                            Style="{ StaticResource btn_feed_reaction }"
                                            TextColor="{ DynamicResource BaseContent }"
                                            Clicked="Reaction_Clicked">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{ Binding disliked }" Value="True">
                                                <Setter Property="TextColor" Value="{ DynamicResource Primary }"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button" Binding="{ Binding liked }" Value="True">
                                                <Setter Property="TextColor" Value="{ DynamicResource BaseContent }"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
