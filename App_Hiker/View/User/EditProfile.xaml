<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:App_Hiker.View.Shared"
             x:Class="App_Hiker.View.User.EditProfile">

    <ContentView.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="lbl_field_title">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextColor" Value="{ DynamicResource BaseContent }"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style TargetType="Entry" x:Key="entry_field">
                <Setter Property="BackgroundColor" Value="{ DynamicResource Base100 }"/>
                <Setter Property="TextColor" Value="{ DynamicResource BaseContent }"/>
                <Setter Property="PlaceholderColor" Value="{ DynamicResource BaseContent }"/>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <ContentView.Content>
        <Grid RowDefinitions="Auto,*">

            <!-- Cabeçalho com botão voltar -->
            <Grid ColumnDefinitions="Auto,*"
                  Padding="10,15"
                  Grid.Row="0">

                <Button Grid.Column="0"
                        Text="&#xf060;"
                        FontFamily="FontAwesomeFreeSolid900"
                        BackgroundColor="Transparent"
                        BorderColor="Transparent"
                        TextColor="{ DynamicResource BaseContent }"
                        CornerRadius="0"
                        Padding="0"
                        WidthRequest="36"
                        Command="{ Binding BackCommand }"/>

                <Label Grid.Column="1"
                       Text="Editar perfil"
                       FontAttributes="Bold"
                       FontSize="16"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       TextColor="{ DynamicResource BaseContent }"/>
            </Grid>

            <!-- Conteúdo -->
            <ScrollView Padding="15" Grid.Row="1">
                <VerticalStackLayout Spacing="20">

                    <!-- Foto de perfil -->
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Border Stroke="{ DynamicResource BaseContent }"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="60"/>
                            </Border.StrokeShape>
                            <Image Source="{ Binding FotoUrl }"
                                   WidthRequest="110"
                                   HeightRequest="110"
                                   Aspect="AspectFill"/>
                        </Border>

                        <Button Text="&#xf030;  Alterar foto"
                                FontFamily="FontAwesomeFreeSolid900"
                                BackgroundColor="Transparent"
                                TextColor="{ DynamicResource Neutral }"
                                BorderColor="{ DynamicResource Neutral }"
                                BorderWidth="1"
                                CornerRadius="8"
                                FontSize="13"
                                HorizontalOptions="Center"
                                Command="{ Binding ChangePhotoCommand }"/>
                    </VerticalStackLayout>

                    <!-- Separador -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="{ DynamicResource Base300 }"/>

                    <!-- Campo: Nome de exibição -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nome de exibição"
                               Style="{ StaticResource lbl_field_title }"/>

                        <Border BackgroundColor="{ DynamicResource Base100 }"
                                Padding="10,0"
                                Stroke="{ DynamicResource BaseContent }"
                                StrokeShape="{ RoundRectangle CornerRadius=5 }">
                            <Entry Text="{ Binding NomeExibicao }"
                                   Placeholder="Seu nome de exibição"
                                   Style="{ StaticResource entry_field }"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botão Salvar -->
                    <Button Text="Salvar alterações"
                            BackgroundColor="{ DynamicResource Success }"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Margin="0,10,0,0"
                            Command="{ Binding SaveCommand }"/>

                </VerticalStackLayout>
            </ScrollView>

            <shared:LoadingOverlay IsVisible="{ Binding IsBusy }"
                                   Grid.RowSpan="2"/>

        </Grid>
    </ContentView.Content>
</ContentView>
