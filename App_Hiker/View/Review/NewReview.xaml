<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:App_Hiker.View.Shared"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="App_Hiker.View.Review.NewReview">
    <ContentView.Content>
        <Grid>
            <ScrollView Padding="15">
                <VerticalStackLayout>
                <Grid  ColumnDefinitions="60, *, Auto"
                       RowDefinitions="Auto, Auto"
                       Padding="10">

                    <!-- Foto de perfil ocupando as 2 linhas -->
                          <Border Grid.Column="0"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            WidthRequest="50"
                            HeightRequest="50"
                            Padding="0"
                            StrokeThickness="0"
                            StrokeShape="Ellipse">
                           <Image Source="{ Binding FotoUrl }"
                               Aspect="AspectFill"/>
                          </Border>

                    <!-- Nome do usuário -->
                    <Label Text="{ Binding UserRealName }"
                           Grid.Column="1"
                           Grid.Row="0"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           Margin="8,0,0,0"/>

                    <!-- Picker Público/Privado -->
                    <Picker ItemsSource="{ Binding VisibilityOptions }"
                           SelectedIndex="{ Binding SelectedVisibilityIndex }"
                           Grid.Column="1"
                           BackgroundColor="#FFF6AF"
                           TitleColor="#E48500"
                           TextColor="#E48500"
                           FontSize="12"
                           Grid.Row="1"
                           Margin="4,0,0,0"
                           HeightRequest="34"
                           MinimumHeightRequest="34"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Start"/>

                    <!-- Estrelas interativas -->
                    <HorizontalStackLayout Grid.Column="2"
                                           Grid.Row="0"
                                           Grid.RowSpan="2"
                                           VerticalOptions="Center"
                                           Spacing="2">
                        <Label Text="★" FontSize="22" TextColor="{ Binding SelectedRating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=1 }">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{ Binding SetRatingCommand }" CommandParameter="1"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="★" FontSize="22" TextColor="{ Binding SelectedRating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=2 }">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{ Binding SetRatingCommand }" CommandParameter="2"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="★" FontSize="22" TextColor="{ Binding SelectedRating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=3 }">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{ Binding SetRatingCommand }" CommandParameter="3"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="★" FontSize="22" TextColor="{ Binding SelectedRating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=4 }">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{ Binding SetRatingCommand }" CommandParameter="4"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="★" FontSize="22" TextColor="{ Binding SelectedRating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=5 }">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{ Binding SetRatingCommand }" CommandParameter="5"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </Grid>
                <Entry Text="{ Binding Local }"
                       Placeholder="Selecione a Cidade"/>

                <CollectionView ItemsSource="{ Binding Suggestions }"
                                IsVisible="{ Binding SuggestionsVisible }"
                                SelectionMode="Single"
                                SelectedItem="{ Binding SelectedSuggestion }">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding .}" Padding="10,8"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Editor HeightRequest="200"
                        Text="{ Binding Descricao }"
                        Placeholder="Compartilhe sua experiência..."
                        VerticalTextAlignment="Start"/>
                <Entry Text="{ Binding Tags }"
                       Placeholder="Palavras que definem a cidade, separadas por vírgula" />
                <!-- Botão adicionar imagem -->
                <Border Margin="0,8,0,0"
                        Padding="14,12"
                        BackgroundColor="{DynamicResource Base200}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{ Binding AddImageCommand }"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Adicione imagens"
                               TextColor="{DynamicResource NeutralContent}"
                               HorizontalTextAlignment="Start"
                               VerticalTextAlignment="Center"
                               HorizontalOptions="Fill"/>
                        <Label Grid.Column="1"
                               Text="{ Binding AddImageCountTexto }"
                               TextColor="{DynamicResource NeutralContent}"
                               HorizontalTextAlignment="End"
                               VerticalTextAlignment="Center"/>
                    </Grid>
                </Border>


                <!-- Preview das imagens em linha -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Margin="0,8,0,0">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{ Binding Fotos }"
                                           Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{ Binding . }"
                                       HeightRequest="100"
                                       WidthRequest="100"
                                       Aspect="AspectFill"/>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <Button Text="Compartilhar"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="8"
                        Margin="0,16,0,0"
                        Command="{ Binding PostCommand }"/>
                </VerticalStackLayout>
            </ScrollView>

            <shared:LoadingOverlay IsVisible="{ Binding IsBusy }"/>
        </Grid>
    </ContentView.Content>
</ContentView>
