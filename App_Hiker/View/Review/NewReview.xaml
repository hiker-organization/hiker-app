<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="App_Hiker.View.Review.NewReview">
    <ContentView.Content>
        <ScrollView Padding="15">
            <VerticalStackLayout>
                <Grid  ColumnDefinitions="60, *, Auto"
                       RowDefinitions="Auto, Auto"
                       Padding="10">

                    <!-- Foto de perfil ocupando as 2 linhas -->
                          <Border Grid.Column="0"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            WidthRequest="50"
                            HeightRequest="50"
                            Padding="0"
                            StrokeThickness="0"
                            StrokeShape="Ellipse">
                           <Image Source="profile.png"
                               x:Name="img_user_photo"
                               Aspect="AspectFill"/>
                          </Border>

                    <!-- Nome do usuário -->
                    <Label Text="Usuário"
                           x:Name="lbl_user_real_name"
                           Grid.Column="1"
                           Grid.Row="0"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           Margin="8,0,0,0"/>

                    <!-- Picker Público/Privado -->
                    <Picker x:Name="PickerVisibility"
                           Grid.Column="1"
                           BackgroundColor="#FFF6AF"
                           TitleColor="#E48500"
                           TextColor="#E48500"
                           FontSize="12"
                           Grid.Row="1"
                           Margin="4,0,0,0"
                           HeightRequest="34"
                           MinimumHeightRequest="34"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Start"
                           SelectedIndexChanged="PickerVisibility_Changed"/>

                    <!-- Estrelas interativas -->
                    <HorizontalStackLayout x:Name="StarsLayout"
                                           Grid.Column="2"
                                           Grid.Row="0"
                                           Grid.RowSpan="2"
                                           VerticalOptions="Center"
                                           Spacing="2">
                        <Label Text="★" FontSize="22" TextColor="LightGray" x:Name="Star1"/>
                        <Label Text="★" FontSize="22" TextColor="LightGray" x:Name="Star2"/>
                        <Label Text="★" FontSize="22" TextColor="LightGray" x:Name="Star3"/>
                        <Label Text="★" FontSize="22" TextColor="LightGray" x:Name="Star4"/>
                        <Label Text="★" FontSize="22" TextColor="LightGray" x:Name="Star5"/>
                    </HorizontalStackLayout>
                </Grid>
                <Entry x:Name="CityEntry"
                       Placeholder="Selecione a Cidade"
                       TextChanged="CityEntry_TextChanged"/>

                <CollectionView x:Name="SuggestionsList"
                                IsVisible="False"
                                SelectionMode="Single"
                                SelectionChanged="SuggestionsList_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding .}" Padding="10,8"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Editor HeightRequest="200"
                        x:Name="DescriptionEditor"
                        Placeholder="Compartilhe sua experiência..."
                        VerticalTextAlignment="Start"/>
                <Entry x:Name="TagsEntry"
                       Placeholder="Palavras que definem a cidade, separadas por vírgula" />
                <!-- Botão adicionar imagem -->
                <Border Margin="0,8,0,0"
                        Padding="14,12"
                        BackgroundColor="{DynamicResource Base200}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AddImage_Clicked"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="AddImageButtonText"
                               Grid.Column="0"
                               Text="Adicione imagens"
                               TextColor="{DynamicResource NeutralContent}"
                               HorizontalTextAlignment="Start"
                               VerticalTextAlignment="Center"
                               HorizontalOptions="Fill"/>
                        <Label x:Name="AddImageButtonCount"
                               Grid.Column="1"
                               Text="+"
                               TextColor="{DynamicResource NeutralContent}"
                               HorizontalTextAlignment="End"
                               VerticalTextAlignment="Center"/>
                    </Grid>
                </Border>


                <!-- Preview das imagens em linha -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Margin="0,8,0,0">
                    <HorizontalStackLayout x:Name="ImagesContainer"
                                           Spacing="8"/>
                </ScrollView>
                <Button Text="Compartilhar"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="8"
                        Margin="0,16,0,0"
                        Clicked="Button_Clicked_Post"/>
            </VerticalStackLayout>
        </ScrollView>
    </ContentView.Content>
</ContentView>
