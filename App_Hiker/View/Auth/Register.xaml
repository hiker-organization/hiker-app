<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:App_Hiker.View.Shared"
             x:Class="App_Hiker.View.Auth.Register"
             Title="Register">
    <ContentPage.Content>
        <Grid ColumnDefinitions="*" RowDefinitions="100,*">
            <Border Grid.Column="0" Grid.Row="0" BackgroundColor="{ DynamicResource Base100 }" Padding="15">
                <Border.Content>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="logo.png" Aspect="AspectFit" />
                    </HorizontalStackLayout>
                </Border.Content>
            </Border>
            <ScrollView Grid.Column="0" Grid.Row="1">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="15">
                    <Label Text="Especifique os dados exigidos abaixo para criar o seu cadastro do aplicativo."/>

                    <Label Text="Usuário:" Style="{ StaticResource lbl_form_field }"/>
                    <Entry Text="{ Binding NomeUsuario }" Placeholder="Crie um nome de usuário..." Keyboard="Text"/>

                    <Label Text="Nome Completo:" Style="{ StaticResource lbl_form_field }"/>
                    <Entry Text="{ Binding NomeCompleto }" Placeholder="Digite seu nome completo aqui..." Keyboard="Text"/>

                    <Label Text="E-mail:" Style="{ StaticResource lbl_form_field }"/>
                    <Entry Text="{ Binding Email }" Placeholder="Digite seu e-mail aqui..." Keyboard="Email"/>

                    <Label Text="Número de Celular:" Style="{ StaticResource lbl_form_field }"/>
                    <Entry Text="{ Binding NumeroCelular }" Placeholder="(XX) XXXXX-XXXX" Keyboard="Telephone"/>

                    <Label Text="Data de Nascimento:" Style="{ StaticResource lbl_form_field }"/>
                    <DatePicker Date="{ Binding DataNascimento }" HorizontalOptions="Fill"/>

                    <Label Text="Senha:" Style="{ StaticResource lbl_form_field }"/>
                    <Entry Text="{ Binding Senha }" Placeholder="Crie uma senha..." Keyboard="Password" IsPassword="True"/>

                    <Label Text="Confirmação da Senha:" Style="{ StaticResource lbl_form_field }"/>
                    <Entry Text="{ Binding ConfirmacaoSenha }" Placeholder="Confirme a senha digitada..." Keyboard="Password" IsPassword="True"/>

                    <Button Text="Cadastrar-se" Margin="0,15,0,0" Style="{ StaticResource btn_primary }" Command="{ Binding RegisterCommand }"/>

                    <Button Text="Já possui uma conta? Clique aqui." Style="{ StaticResource btn_route }" Command="{ Binding BackToLoginCommand }"/>
                </VerticalStackLayout>
            </ScrollView>

            <shared:LoadingOverlay IsVisible="{ Binding IsBusy }"
                                   Grid.RowSpan="2"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>
