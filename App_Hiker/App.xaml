<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:App_Hiker"
             x:Class="App_Hiker.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Light/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Label" x:Key="lbl_title">
                <Setter Property="FontFamily" Value="AclonicaRegular"/>
                <Setter Property="FontSize" Value="35"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
                <Setter Property="TextColor" Value="{ DynamicResource Primary }"/>
            </Style>

            <Style TargetType="Button" x:Key="btn_primary">
                <Setter Property="Background" Value="{ DynamicResource Primary }"/>
                <Setter Property="BorderColor" Value="{ DynamicResource Primary }"/>
                <Setter Property="TextColor" Value="{ DynamicResource PrimaryContent }"/>
            </Style>

            <Style TargetType="Button" x:Key="btn_route">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="BorderWidth" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="VerticalOptions" Value="Center"/>
                <Setter Property="Padding" Value="0"/>
                 <Setter Property="TextColor" Value="{ DynamicResource RouteButtonText }"/>
                 <Setter Property="FontAttributes" Value="None"/>
            </Style>

            <Style TargetType="Label" x:Key="lbl_form_field">
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HorizontalTextAlignment" Value="Start" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
