<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_Hiker.Layout.MainTabBar"
             Title="MainTabBar">
    <ContentPage.Resources>
        <Style TargetType="Grid" x:Key="grid_main_tabs">
            <Setter Property="BackgroundColor" Value="{ DynamicResource Base300 }"/>
            <Setter Property="ColumnSpacing" Value="5"/>
            <Setter Property="RowSpacing" Value="5"/>
        </Style>

        <Style TargetType="Button" x:Key="btn_grid_main_tabs">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="BorderColor" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="FontFamily" Value="FontAwesomeFreeSolid900"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentPage.Resources>
    
    <ContentPage.Content>
        <Grid ColumnDefinitions="*" RowDefinitions="*,60">
            <ContentView x:Name="ctview_page" Grid.Column="0" Grid.Row="0"/>

            <Grid x:Name="grid_main_tabs" ColumnDefinitions="*,*,*" RowDefinitions="*" Grid.Column="0" Grid.Row="1" Style="{ DynamicResource grid_main_tabs }">
                <Button Text="&#xf015;" Grid.Column="0" Grid.Row="0" Style="{ StaticResource btn_grid_main_tabs }" Clicked="tab_Clicked"/>

                <Button Text="&#x2b;" Grid.Column="1" Grid.Row="0" Style="{ StaticResource btn_grid_main_tabs }" Clicked="tab_Clicked"/>

                <Button Text="&#xf007;" Grid.Column="2" Grid.Row="0" Style="{ StaticResource btn_grid_main_tabs }" Clicked="tab_Clicked"/>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>